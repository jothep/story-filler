# Standalone static image that retains the /story-filler/ URL prefix.

# --- Stage 1: Build ---
FROM node:24-bookworm-slim@sha256:c86ecead9e55a5210ac1727de38a4ca840bf03dcaf34dc9749addbf383b1920c AS builder

WORKDIR /app

COPY package.json package-lock.json ./

RUN npm ci

COPY . .

RUN npm run build

# --- Stage 2: Serve with nginx ---
FROM nginx:stable-alpine@sha256:0e52bd054126cdc040b1276c0af347aeb02a41b9cfe305d6094767ac30e97949

# Apply available distribution security updates when rebuilding the image.
RUN apk upgrade --no-cache

# Match the Vite public base and support SPA route refreshes.
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built static files from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html/story-filler

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
