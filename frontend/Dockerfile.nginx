# Dockerfile.nginx - nginx-based frontend image
# The final image serves static files without a Node.js runtime.
# Switched from serve to nginx:alpine on 2026-03-08 to resolve CVE issues

# --- Stage 1: Build ---
FROM node:24-bookworm-slim AS builder

WORKDIR /app

COPY package.json package-lock.json ./

RUN npm ci

COPY . .

RUN npm run build

# --- Stage 2: Serve with nginx ---
FROM nginx:alpine

# Update Alpine packages to fix security vulnerabilities
# CVE-2026-22184 (zlib) and CVE-2026-25646 (libpng)
RUN apk update && \
    apk upgrade --no-cache && \
    rm -rf /var/cache/apk/*

# Match the Vite public base and support SPA route refreshes.
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built static files from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html/story-filler

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
