{
  "name": "frontend",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/create-pages-fallback.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:pages": "node --test scripts/check-pages-requests.mjs scripts/check-pages-fallback.mjs",
    "test:lint": "node --test scripts/check-lint-config.mjs",
    "lint": "npm run lint:js && npm run typecheck",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint:js": "oxlint --config oxlint.config.mjs --disable-nested-config --deny-warnings --report-unused-disable-directives-severity=error .",
    "typecheck": "node scripts/check-types.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@fontsource/press-start-2p": "^5.2.7",
    "nes.css": "^2.2.1",
    "prop-types": "^15.8.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/prop-types": "15.7.15",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.2.0",
    "globals": "^16.4.0",
    "jsdom": "^27.4.0",
    "oxlint": "1.90.0",
    "prettier": "^3.6.2",
    "typescript": "6.0.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "24.x"
  }
}
