# GCP 项目配置
gcp_project_id = "your-gcp-project-id"
gcp_region     = "us-central1"

# Neon 数据库连接
# Supply TF_VAR_database_url in the private process environment.

# Django 密钥（生成：python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'）
# Supply TF_VAR_django_secret_key in the private process environment.

# 前端配置
allowed_hosts        = "*"
cors_allowed_origins = "https://yourusername.github.io"
