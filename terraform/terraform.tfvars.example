# ============================================
# Maori Story Fill - Terraform 变量示例
# ============================================
# 复制此文件为 terraform.tfvars 并填写实际值
# 注意：terraform.tfvars 包含敏感信息，已在 .gitignore 中排除

# ----------------------
# AWS 基础配置
# ----------------------

# AWS 区域（推荐 us-east-1，成本最低）
aws_region = "us-east-1"

# 环境名称
environment = "prod"

# ----------------------
# 网络配置
# ----------------------

# VPC ID（留空使用默认 VPC）
# 查看默认 VPC: aws ec2 describe-vpcs --filters "Name=is-default,Values=true"
vpc_id = ""

# 子网 ID（留空使用默认子网）
# 查看子网: aws ec2 describe-subnets --filters "Name=vpc-id,Values=<vpc-id>"
subnet_id = ""

# 允许 SSH 访问的 IP（建议改为你的公网 IP）
# 查看你的 IP: curl ifconfig.me
allowed_ssh_cidrs = ["0.0.0.0/0"]  # 生产环境改为: ["YOUR_IP/32"]

# ----------------------
# EC2 实例配置
# ----------------------

# 实例类型（t3.small 推荐，2GB RAM）
instance_type = "t3.small"

# SSH 密钥对名称（必须提前创建）
# 创建密钥: aws ec2 create-key-pair --key-name maori-story-key --query 'KeyMaterial' --output text > ~/.ssh/maori-story-key.pem
# 或在 AWS Console: EC2 > Key Pairs > Create key pair
key_pair_name = "maori-story-key"

# 根卷大小（GB）
root_volume_size = 30

# ----------------------
# 应用配置（敏感信息）
# ----------------------

# PostgreSQL 数据库密码（请使用强密码）
db_password = "your_strong_database_password_here"

# Django 密钥（使用下面命令生成）
# python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
django_secret_key = "your-django-secret-key-at-least-50-characters-long"

# Git 仓库 URL
git_repo_url = "https://github.com/your-username/maori-story-fill.git"

# Git 分支
git_branch = "main"

# ----------------------
# 监控配置（可选）
# ----------------------

# 启用详细监控（额外费用 ~$2/月）
enable_detailed_monitoring = false

# 启用 CloudWatch 告警
enable_cloudwatch_alarms = false

# 告警通知的 SNS Topic ARN（如果启用告警）
# alarm_sns_topic_arn = "arn:aws:sns:us-east-1:123456789012:maori-story-alerts"

# ----------------------
# 额外标签（可选）
# ----------------------

additional_tags = {
  Owner       = "YourName"
  CostCenter  = "Engineering"
  Application = "MaoriStoryFill"
}
