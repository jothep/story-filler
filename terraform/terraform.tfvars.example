# ============================================
# Maori Story Fill - Terraform变量值示例
# ============================================
# 复制此文件为 terraform.tfvars 并填写实际值
# cp terraform.tfvars.example terraform.tfvars
#
# ⚠️ 警告：terraform.tfvars 包含敏感信息，已在 .gitignore 中排除
# ============================================

# ============================================
# GCP 项目配置
# ============================================

gcp_project_id = "your-gcp-project-id"  # 替换为你的 GCP 项目 ID
gcp_region     = "us-central1"           # 推荐 us-central1（免费层可用）
environment    = "prod"                  # 环境：dev, staging, 或 prod

# ============================================
# 数据库配置（免费数据库服务）
# ============================================

# 示例1：使用 Neon (https://neon.tech) - 推荐
database_url = "postgresql://username:${DB_PASSWORD}@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# 示例2：使用 Supabase (https://supabase.com)
# database_url = "postgresql://postgres:${DB_PASSWORD}@db.xxx.supabase.co:5432/postgres"

# 示例3：使用 ElephantSQL (https://www.elephantsql.com)
# database_url = "postgresql://username:${DB_PASSWORD}@xxx.db.elephantsql.com/xxx"

# ============================================
# Django 密钥
# ============================================

# 生成方法：
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
django_secret_key = "your-django-secret-key-here-replace-with-random-50-chars"

# ============================================
# 应用配置
# ============================================

# Django ALLOWED_HOSTS（Cloud Run 会自动添加服务URL）
allowed_hosts = "*"  # 生产环境可改为具体域名

# CORS配置（前端GitHub Pages URL）
cors_allowed_origins = "https://your-username.github.io,https://yourusername.github.io"

# CORS配置（列表格式）
cors_allowed_origins_list = [
  "https://your-username.github.io",
  "https://yourusername.github.io"
]

# ============================================
# Secret Manager 配置（可选）
# ============================================

use_secret_manager = false  # false=直接环境变量（测试）, true=Secret Manager（生产）

# ============================================
# Cloud Run 配置（已优化免费层）
# ============================================
# 注意：扩缩容和资源配置已固定为：
# - min_instances = 0（无流量时缩减到0）
# - max_instances = 1（严格成本控制）
# - cpu = "1" (1 vCPU)
# - memory = "512Mi" (512MB)
# 无需在此配置，如需修改请编辑 terraform/main.tf

# ============================================
# 媒体文件存储（可选）
# ============================================

# 选项1：使用 AWS S3（已有S3配置）
use_s3 = "true"
aws_access_key_id        = "your-aws-access-key"
aws_secret_access_key    = "your-aws-secret-key"
aws_storage_bucket_name  = "your-s3-bucket-name"

# 选项2：使用 GCS（创建新bucket）
# use_s3 = "false"
# use_gcs_for_media = true
# gcs_location = "US"

# 选项3：不使用对象存储（使用Cloud Run临时存储，不推荐）
# use_s3 = "false"
# use_gcs_for_media = false

# ============================================
# 免费资源推荐
# ============================================

# 数据库（选一个）：
# - Neon: 500MB 免费 (https://neon.tech)
# - Supabase: 500MB 免费 (https://supabase.com)
# - ElephantSQL: 20MB 免费 (https://www.elephantsql.com)
# - Render PostgreSQL: 90天免费试用 (https://render.com)

# 对象存储（选一个）：
# - AWS S3: 5GB 免费（12个月）
# - GCS: 5GB 免费（Always Free）
# - Cloudflare R2: 10GB 免费
# - Backblaze B2: 10GB 免费

# 前端托管：
# - GitHub Pages: 免费（你已选择）

# 总成本估算：
# - Cloud Run: $0-2/月（轻度使用）
# - Artifact Registry: $0/月（< 500MB）
# - 数据库: $0/月（免费层）
# - 对象存储: $0/月（免费层）
# ============================
# 总计: $0-2/月 🎉
