# Cloud Run Environment Variables Example
# Copy this file to env-vars.yaml and fill in your actual values

DATABASE_URL: "postgresql://user:${DB_PASSWORD}@host:5432/database?sslmode=require"
SECRET_KEY: "your-django-secret-key-here"
DEBUG: "False"
ALLOWED_HOSTS: "*"
USE_GCS: "true"
GS_BUCKET_NAME: "your-gcs-bucket-name"
CORS_ALLOWED_ORIGINS: "http://localhost:5173,http://localhost:8080,https://your-github-username.github.io"
CSRF_TRUSTED_ORIGINS: "http://localhost:8000,http://localhost"
CSRF_TRUSTED_ORIGIN_WILDCARDS: "https://*.run.app"
