FROM python:3.13.18-alpine3.24@sha256:7984cf56ceaddebe4fefeb75d64000b9f45d8b77b11a09b24524da6cdc3af0c8 AS wheel-builder

WORKDIR /build

# These two dependencies have no musllinux wheels. Keep their compiler and
# development headers in this stage, and require the native CRC32C extension.
RUN apk add --no-cache build-base=0.5-r4 crc32c-dev=1.1.2-r3
COPY requirements.txt requirements-build.txt ./
RUN python -m pip install --no-cache-dir --require-hashes --only-binary=:all: \
        -r requirements-build.txt \
    && CRC32C_PURE_PYTHON=0 python -m pip wheel --no-cache-dir --require-hashes \
        --only-binary=:all: --no-binary=google-crc32c,zope-interface \
        --no-deps --no-build-isolation -r requirements.txt --wheel-dir /wheels

FROM python:3.13.18-alpine3.24@sha256:7984cf56ceaddebe4fefeb75d64000b9f45d8b77b11a09b24524da6cdc3af0c8

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Preserve the existing runtime IDs. CRC32C remains a runtime library; its
# headers and the compiler are deliberately absent from this final stage.
RUN apk upgrade --no-cache \
    && apk add --no-cache crc32c=1.1.2-r3 \
    && addgroup -S -g 101 app \
    && adduser -S -D -u 100 -G app app \
    && chown app:app /app

# All input hashes were verified above. Mount only those resulting wheels so
# build artifacts do not occupy layers in the application image.
RUN --mount=from=wheel-builder,source=/wheels,target=/wheels \
    python -m pip install --no-cache-dir --no-index --no-deps --only-binary=:all: \
        /wheels/*.whl \
    && python -m pip check \
    && python -c 'from google_crc32c import implementation; assert implementation == "c"' \
    && python -c 'import zope.interface._zope_interface_coptimizations' \
    && python -c 'from gunicorn.workers.ggevent import GeventWorker' \
    && python -m pip uninstall --yes pip \
    && rm -rf /usr/local/lib/python3.13/ensurepip

COPY --chown=app:app . .
USER app

# Generate static assets without cloud credentials or a database connection.
# Run as app so generated log and static files retain the runtime ownership.
RUN SECRET_KEY="$(python -c 'import secrets; print(secrets.token_urlsafe(64))')" \
    DATABASE_URL="sqlite:///:memory:" \
    USE_GCS=false \
    python manage.py collectstatic --noinput

EXPOSE 8000

CMD ["gunicorn", "--workers", "3", "--worker-class", "gevent", \
     "--no-control-socket", "--bind", "0.0.0.0:8000", \
     "maori_story_project.wsgi:application"]
