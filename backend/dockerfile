FROM python:3.13.18-alpine3.24@sha256:7984cf56ceaddebe4fefeb75d64000b9f45d8b77b11a09b24524da6cdc3af0c8 AS wheel-builder

WORKDIR /build

# These two dependencies have no musllinux wheels. Keep their compiler and
# development headers in this stage, and require the native CRC32C extension.
RUN apk add --no-cache build-base=0.5-r4 crc32c-dev=1.1.2-r3
COPY requirements.txt requirements-build.txt ./
RUN python -m pip install --no-cache-dir --require-hashes --only-binary=:all: \
        -r requirements-build.txt \
    && CRC32C_PURE_PYTHON=0 python -m pip wheel --no-cache-dir --require-hashes \
        --only-binary=:all: --no-binary=google-crc32c,zope-interface \
        --no-deps --no-build-isolation -r requirements.txt --wheel-dir /wheels

FROM python:3.13.18-alpine3.24@sha256:7984cf56ceaddebe4fefeb75d64000b9f45d8b77b11a09b24524da6cdc3af0c8 AS clean-runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Production uses PostgreSQL. Remove the optional SQLite Python modules, then
# rebuild the official base's virtual runtime dependency package from the
# remaining Python binaries. APK removes SQLite normally and retains other
# required libraries. Do this before adding wheels with private shared libraries.
RUN set -eu; \
    set -o pipefail; \
    rm -rf /usr/local/lib/python3.13/sqlite3; \
    rm -f /usr/local/lib/python3.13/dbm/sqlite3.py; \
    rm -f /usr/local/lib/python3.13/lib-dynload/_sqlite3*.so; \
    python_runtime_dependencies="$( \
        find /usr/local -type f -not -name '*tkinter*' \
            -exec scanelf --needed --nobanner --format '%n#p' '{}' + \
            | tr ',' '\n' \
            | sort -u \
            | awk 'system("[ -e /usr/local/lib/" $1 " ]") == 0 { next } { print "so:" $1 }' \
    )"; \
    test -n "$python_runtime_dependencies"; \
    apk add --no-network --virtual .python-runtime $python_runtime_dependencies; \
    apk del --no-network .python-rundeps sqlite-libs; \
    python -c 'import importlib.util; assert all(importlib.util.find_spec(name) is None for name in ("sqlite3", "_sqlite3", "dbm.sqlite3"))'

# Preserve the existing runtime IDs. CRC32C remains a runtime library; its
# headers and the compiler are deliberately absent from this final stage.
RUN apk upgrade --no-cache \
    && apk add --no-cache crc32c=1.1.2-r3 \
    && addgroup -S -g 101 app \
    && adduser -S -D -u 100 -G app app \
    && chown app:app /app

# All input hashes were verified above. Mount only those resulting wheels so
# build artifacts do not occupy layers in the application image.
RUN --mount=from=wheel-builder,source=/wheels,target=/wheels \
    python -m pip install --no-cache-dir --no-index --no-deps --only-binary=:all: \
        /wheels/*.whl \
    && python -m pip check \
    && python -c 'from google_crc32c import implementation; assert implementation == "c"' \
    && python -c 'import zope.interface._zope_interface_coptimizations' \
    && python -c 'from gunicorn.workers.ggevent import GeventWorker' \
    && python -m pip uninstall --yes pip \
    && rm -rf /usr/local/lib/python3.13/ensurepip

COPY --chown=app:app . .
USER app

# Generate static assets without cloud credentials or a database connection.
# Run as app so generated log and static files retain the runtime ownership.
RUN --network=none SECRET_KEY="$(python -c 'import secrets; print(secrets.token_urlsafe(64))')" \
    DATABASE_URL="postgresql://build@127.0.0.1:5432/build" \
    USE_GCS=false \
    python manage.py collectstatic --noinput

# Copy the complete cleaned filesystem, including package metadata. Starting
# from scratch keeps SQLite out of the published layers, not just hidden by
# deletion markers over the original Python base layers.
FROM scratch
COPY --from=clean-runtime / /

ENV PATH=/usr/local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LANG=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
USER app
EXPOSE 8000

CMD ["gunicorn", "--workers", "3", "--worker-class", "gevent", \
     "--no-control-socket", "--bind", "0.0.0.0:8000", \
     "maori_story_project.wsgi:application"]
