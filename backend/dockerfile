FROM python:3.13-slim@sha256:2d44738ebf4ce5f63b9d9ea871e9c7cfdc0426f7b0c97cac915fd88ded1d86bb

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# All runtime dependencies have published wheels. Verify their locked hashes;
# no compiler, development tools or unpinned source builds are needed.
COPY requirements.txt .
RUN python -m pip install --no-cache-dir --require-hashes --only-binary=:all: \
        -r requirements.txt \
    && python -m pip check \
    && python -m pip uninstall --yes pip \
    && rm -rf /usr/local/lib/python3.13/ensurepip \
    && python -c 'from gunicorn.workers.ggevent import GeventWorker'

# Create the persistent runtime account before removing its setup tools and mount.
# Keep the available time-zone update explicit; preserve essential OS packages.
RUN addgroup --system app \
    && adduser --system --group app \
    && chown app:app /app \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends \
        tzdata=2026f-0+deb13u1 \
    && apt-get purge --yes --auto-remove adduser mount passwd \
    && apt-get check \
    && rm -rf /var/lib/apt/lists/*
COPY --chown=app:app . .

# Build-created logs and static files must also belong to the runtime user.
USER app

# Static assets are built without production credentials or a database connection.
RUN SECRET_KEY="$(python -c 'import secrets; print(secrets.token_urlsafe(64))')" \
    DATABASE_URL="sqlite:///:memory:" \
    USE_GCS=false \
    python manage.py collectstatic --noinput

EXPOSE 8000

CMD ["gunicorn", "--workers", "3", "--worker-class", "gevent", \
     "--no-control-socket", "--bind", "0.0.0.0:8000", \
     "maori_story_project.wsgi:application"]
