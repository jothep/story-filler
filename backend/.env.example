# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DATABASE_URL=postgres://user:${DB_PASSWORD}@postgres-svc:5432/maori_story_db

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# =================================================================
# Storage Configuration
# =================================================================
# Choose ONE of the following storage modes by setting USE_S3:
# - false (default): Local file storage
# - true: S3-compatible storage (AWS S3 or MinIO)
# =================================================================

# Mode 1: Local Storage (DEFAULT)
# USE_S3=false
# MEDIA_ROOT=/app/media  # Optional, defaults to backend/media

# Mode 2: AWS S3
# USE_S3=true
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_STORAGE_BUCKET_NAME=maori-story-media
# AWS_S3_REGION_NAME=ap-southeast-2

# Mode 3: MinIO (Self-hosted S3-compatible)
# USE_S3=true
# AWS_ACCESS_KEY_ID=REMOVED_CREDENTIAL
# AWS_SECRET_ACCESS_KEY=REMOVED_CREDENTIAL
# AWS_STORAGE_BUCKET_NAME=maori-story
# AWS_S3_ENDPOINT_URL=http://minio:9000
# AWS_S3_REGION_NAME=us-east-1
