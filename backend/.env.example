# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DATABASE_URL=postgres://user:${DB_PASSWORD}@postgres-svc:5432/maori_story_db

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Storage Configuration
# USE_GCS=false  # Set to true for production (GCS), false for local development
# MEDIA_ROOT=/app/media  # Only used when USE_GCS=false
# GS_BUCKET_NAME=maori-story-media  # Only used when USE_GCS=true
