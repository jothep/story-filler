# Fill the empty values privately; never commit the resulting .env.
# Django Configuration
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DATABASE_URL=

# CORS Configuration
# For development: local Vite dev server
# For production: add GitHub Pages URL
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,https://jothep.github.io

# Storage Configuration
# USE_GCS=false  # Set to true for production (GCS), false for local development
# MEDIA_ROOT=/app/media  # Only used when USE_GCS=false
# GS_BUCKET_NAME=maori-story-media  # Only used when USE_GCS=true
