# ==============================================
# Maori Story Fill - 环境变量配置模板
# ==============================================
# 复制此文件为 .env 并填写实际值

# ----------------------------------------------
# 数据库配置
# ----------------------------------------------
# PostgreSQL 数据库密码（请修改为强密码）
DB_PASSWORD=REMOVED_CREDENTIAL

# ----------------------------------------------
# Django 配置
# ----------------------------------------------
# Django 密钥（必须修改！使用下面命令生成）
# python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=REMOVED_CREDENTIAL

# Django 调试模式（生产环境必须设置为 False）
DJANGO_DEBUG=False

# 允许的主机（生产环境请设置为实际域名或IP）
# 示例: ALLOWED_HOSTS=example.com,www.example.com,123.456.789.0
ALLOWED_HOSTS=*

# ----------------------------------------------
# 可选配置（根据需要取消注释）
# ----------------------------------------------

# 如果使用 AWS S3 存储媒体文件（可选）
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_STORAGE_BUCKET_NAME=maori-story-media
# AWS_S3_REGION_NAME=us-east-1

# 如果使用其他云存储（可选）
# CLOUD_STORAGE_PROVIDER=local  # local, s3, azure, gcs

# ----------------------------------------------
# 生产环境优化
# ----------------------------------------------
# Gunicorn workers 数量（默认：3）
# GUNICORN_WORKERS=3

# 数据库连接池（默认：600秒）
# DB_CONN_MAX_AGE=600

# ----------------------------------------------
# 备份配置（可选）
# ----------------------------------------------
# 自动备份频率（cron 格式）
# BACKUP_SCHEDULE="0 2 * * *"  # 每天凌晨2点

# 备份保留天数
# BACKUP_RETENTION_DAYS=7
